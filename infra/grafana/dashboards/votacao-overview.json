{
  "title": "Sistema de Votação - Visão Geral",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Votos registrados por minuto",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(votacao_eventos_dominio_total{tipo=\"VotoRegistrado\"}[1m]) * 60", "legendFormat": "votos/min" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Eventos processados pelo result-service",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum by (resultado) (rate(votacao_eventos_processados_total[1m]))", "legendFormat": "{{resultado}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Eventos publicados no RabbitMQ (voting-service)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum by (resultado) (rate(votacao_eventos_publicados_total[1m]))", "legendFormat": "{{resultado}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latência HTTP p95 (voting-service)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"voting-service\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Instâncias saudáveis (UP) por serviço",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [ { "expr": "up{job=~\"voting-service|result-service|audit-service\"}", "legendFormat": "{{job}}" } ]
    }
  ]
}
